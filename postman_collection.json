		{
			"name": "7. Payment (Paystack)",
			"item": [
				{
					"name": "POST Initiate Payment",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 5000.00\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/payment/initiate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payment", "initiate"] }
					}
				},
				{
					"name": "GET Payment History",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/v1/payment/history", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payment", "history"] }
					}
				},
				{
					"name": "POST Paystack Webhook (Public)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "x-paystack-signature", "value": "SIGNATURE" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"event\": \"charge.success\",\n  \"data\": {\n    \"reference\": \"KLD-XXXXXXXXXXXX\",\n    \"status\": \"success\",\n    \"amount\": 500000,\n    \"channel\": \"card\",\n    \"gateway_response\": \"Successful\"\n  }\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/payment/webhook", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payment", "webhook"] }
					}
				}
			]
		},
