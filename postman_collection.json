					"name": "POST Reject Order (DryCleaner)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderId\": 1,\n  \"dryCleanerId\": 1,\n  \"reason\": \"Out of capacity\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/order/reject", "host": ["{{baseUrl}}"], "path": ["api", "v1", "order", "reject"] }
					}
				},
				{
					"name": "PATCH Update Order Status",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderId\": 1,\n  \"status\": \"IN_PROGRESS\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/order/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "order", "status"] }
					}
				},
