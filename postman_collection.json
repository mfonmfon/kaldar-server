						"body": {
							"mode": "raw",
							"raw": "{\n  \"businessName\": \"Clean & Fresh\",\n  \"email\": \"store@cleanfresh.com\",\n  \"password\": \"Password123!\",\n  \"phoneNumber\": \"+2348087654321\",\n  \"address\": \"Lekki, Lagos\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/drycleaner/drycleaner/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "drycleaner", "drycleaner", "register"] }
