						"url": { "raw": "{{baseUrl}}/api/v1/drycleaner/drycleaner/1/services", "host": ["{{baseUrl}}"], "path": ["api", "v1", "drycleaner", "drycleaner", "1", "services"] }
					}
				},
				{
					"name": "GET Onboarding Status",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/v1/drycleaner/drycleaner/1/onboarding-status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "drycleaner", "drycleaner", "1", "onboarding-status"] }
