{
	"info": {
		"_postman_id": "kaldar-complete-api-collection-v1",
		"name": "Kaldar Platform API — Complete Collection (All 13 Controllers)",
		"description": "Production Postman Collection containing all API endpoints across the Kaldar Laundry & Dry Cleaning Monorepo.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "YOUR_JWT_TOKEN_HERE",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication & OTP",
			"item": [
				{
					"name": "POST User Login",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@kaldar.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
					}
				},
				{
					"name": "POST Verify OTP",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@kaldar.com\",\n  \"otpInput\": \"123456\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "verify-otp"] }
					}
				},
				{
					"name": "POST Resend OTP",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@kaldar.com\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "resend-otp"] }
					}
				},
				{
					"name": "POST Forgot Password",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@kaldar.com\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/auth/forgot_password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "forgot_password"] }
					}
				},
				{
					"name": "POST Reset Password",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@kaldar.com\",\n  \"resetToken\": \"TOKEN123\",\n  \"newPassword\": \"NewPassword123!\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/auth/reset_password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "reset_password"] }
					}
				}
			]
		},
		{
			"name": "2. Customer Module",
			"item": [
				{
					"name": "POST Register Customer",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"Password123!\",\n  \"phoneNumber\": \"+2348012345678\",\n  \"address\": \"15 Victoria Island, Lagos\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/customer/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "customer", "register"] }
					}
				},
				{
					"name": "PUT Update Profile",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Updated\",\n  \"phoneNumber\": \"+2348012345678\",\n  \"address\": \"20 Lekki Phase 1, Lagos\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/customer/updated_customer_profile", "host": ["{{baseUrl}}"], "path": ["api", "v1", "customer", "updated_customer_profile"] }
					}
				},
				{
					"name": "GET Customer Profile",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/v1/customer/1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "customer", "1"] }
					}
				},
				{
					"name": "PUT Change Password",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"oldPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/customer/change_password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "customer", "change_password"] }
					}
				}
			]
		},
