					"name": "GET Store Analytics",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/v1/drycleaner/drycleaner/1/analytics?period=today", "host": ["{{baseUrl}}"], "path": ["api", "v1", "drycleaner", "drycleaner", "1", "analytics"] }
					}
				}
			]
		},
		{
			"name": "4. Discovery",
			"item": [
				{
					"name": "POST Search Available Dry Cleaners Nearby",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"lat\": 6.4531,\n  \"lng\": 3.3958,\n  \"radiusKm\": 10.0,\n  \"openNow\": true\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/drycleaners/available", "host": ["{{baseUrl}}"], "path": ["api", "v1", "drycleaners", "available"] }
					}
				}
			]
		},
		{
			"name": "5. Order & Review",
			"item": [
				{
					"name": "POST Place Order",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": 1,\n  \"dryCleanerId\": 1,\n  \"pickupAddress\": \"Lagos\",\n  \"deliveryAddress\": \"Lagos\",\n  \"serviceItems\": [\n    { \"serviceOfferingId\": 1, \"quantity\": 2 }\n  ]\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/order", "host": ["{{baseUrl}}"], "path": ["api", "v1", "order"] }
					}
				},
				{
					"name": "POST Accept Order (DryCleaner)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderId\": 1,\n  \"dryCleanerId\": 1\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/order/accept", "host": ["{{baseUrl}}"], "path": ["api", "v1", "order", "accept"] }
					}
				},
