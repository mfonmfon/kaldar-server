{
	"info": {
		"_postman_id": "kaldar-api-collection-v1",
		"name": "Kaldar API — Notification, Favourite, Wallet & Payment",
		"description": "Production Postman Collection for testing Kaldar Monorepo REST Endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "YOUR_CUSTOMER_JWT_TOKEN_HERE",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login (Customer / Admin)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@kaldar.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. Customer Wallet",
			"item": [
				{
					"name": "GET Wallet Balance",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/wallet/balance",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "wallet", "balance"]
						}
					}
				},
				{
					"name": "GET Wallet Summary (History)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/wallet/1/summary",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "wallet", "1", "summary"]
						}
					}
				},
				{
					"name": "POST Credit Wallet (Internal)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": 1,\n  \"amount\": 5000.00,\n  \"description\": \"Manual top-up test\",\n  \"reference\": \"MANUAL-REF-001\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/wallet/credit",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "wallet", "credit"]
						}
					}
				},
				{
					"name": "POST Debit Wallet (Internal)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": 1,\n  \"amount\": 1500.00,\n  \"description\": \"Order payment test\",\n  \"reference\": \"ORD-DEBIT-001\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/wallet/debit",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "wallet", "debit"]
						}
					}
				}
			]
		},
		{
			"name": "3. Payment (Paystack)",
			"item": [
				{
					"name": "POST Initiate Payment",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 5000.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/payment/initiate",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "payment", "initiate"]
						}
					}
				},
				{
					"name": "GET Payment History",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/payment/history",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "payment", "history"]
						}
					}
				},
				{
					"name": "POST Paystack Webhook (Public)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "x-paystack-signature", "value": "SIGNATURE_HASH_HERE" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"event\": \"charge.success\",\n  \"data\": {\n    \"reference\": \"KLD-XXXXXXXXXXXX\",\n    \"status\": \"success\",\n    \"amount\": 500000,\n    \"channel\": \"card\",\n    \"gateway_response\": \"Successful\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/payment/webhook",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "payment", "webhook"]
						}
					}
				}
			]
		},
		{
			"name": "4. Favorites",
			"item": [
				{
					"name": "GET Saved Favourites",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/favorites",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "favorites"]
						}
					}
				},
				{
					"name": "POST Add to Favourites",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/v1/favorites/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "favorites", "1"]
						}
					}
				},
				{
					"name": "DELETE Remove from Favourites",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/v1/favorites/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "favorites", "1"]
						}
					}
				}
			]
		},
		{
			"name": "5. Notifications",
			"item": [
				{
					"name": "GET Notifications (Paginated)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/notifications?page=0&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "notifications"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "limit", "value": "10" },
								{ "key": "type", "value": "ORDER_UPDATE", "disabled": true },
								{ "key": "read", "value": "false", "disabled": true }
							]
						}
					}
				},
				{
					"name": "PATCH Toggle Notification Read Status",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"isRead\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/notifications/1/read",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "notifications", "1", "read"]
						}
					}
				},
				{
					"name": "DELETE Single Notification",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/v1/notifications/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "notifications", "1"]
						}
					}
				},
				{
					"name": "POST Bulk Mark Notifications Read",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"ids\": [1, 2, 3]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/notifications/bulk/read",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "notifications", "bulk", "read"]
						}
					}
				},
				{
					"name": "POST Bulk Mark Notifications Unread",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"ids\": [1, 2, 3]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/notifications/bulk/unread",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "notifications", "bulk", "unread"]
						}
					}
				},
				{
					"name": "POST Bulk Delete Notifications",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"ids\": [1, 2, 3]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/notifications/bulk/delete",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "notifications", "bulk", "delete"]
						}
					}
				},
				{
					"name": "POST Mark All Notifications Read",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/v1/notifications/read-all",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "notifications", "read-all"]
						}
					}
				}
			]
		}
	]
}
