					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderId\": 1,\n  \"customerId\": 1,\n  \"dryCleanerId\": 1,\n  \"rating\": 5,\n  \"comment\": \"Great service!\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/order/review", "host": ["{{baseUrl}}"], "path": ["api", "v1", "order", "review"] }
					}
				}
			]
